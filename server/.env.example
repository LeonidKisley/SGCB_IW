# ============================================================
# Plantilla de variables de entorno del backend
# Copia este archivo como .env y ajusta los valores si es necesario.
# ============================================================

# Puerto donde escucha la API REST
PORT=5000

# Cadena de conexión a la instancia local de MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/sgcb

# Origen permitido por CORS (el servidor de Vite en desarrollo)
CLIENT_URL=http://localhost:5173

# Entorno de ejecución (development | production)
NODE_ENV=development
